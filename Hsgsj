            for i = 1, 15 do
                local ok, result = pcall(debug.getupvalue, Get, i)
                if ok and type(result) == "table" then
                    for _, data in pairs(result) do
                        if type(data) == "table" then
                            local baseSkins = data:Get("BaseSkinInventory")
