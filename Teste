local gti = getthreadidentity or get_thread_identity or getidentity
local sti = setthreadidentity or set_thread_identity or setidentity
local trampoline

local function spoof(fn, ...)
    if not trampoline then
        local ok = pcall(function()
            local src = "return function(e,f,...) setfenv(0,e) local function c(...) return f(...) end local function b(...) return c(...) end local function a(...) return b(...) end return a(...) end"
            local chunk = loadstring(src, "=" .. mask:GetFullName())
            local ok2, env = pcall(getsenv, mask)
            local renv = getrenv()
            setfenv(chunk, (ok2 and type(env) == "table") and env
                or setmetatable({script=mask,_G={},shared={}}, {__index=renv,__newindex=renv}))
            trampoline = chunk()
        end)
        if not ok or not trampoline then return nil end
    end

    local gu = getupvalues or (debug and debug.getupvalues)
    local su = setupvalue  or (debug and debug.setupvalue)
    local restored = {}
    if gu and su then
        local ok2, uvs = pcall(gu, fn)
        if ok2 and type(uvs) == "table" then
            for i, v in pairs(uvs) do
                if typeof(v) == "Instance" and v:IsA("LuaSourceContainer") then
                    if pcall(su, fn, i, mask) then restored[i] = v end
                end
            end
        end
    end

    local prev = gti(); sti(2)
    local ok3, result = coroutine.resume(coroutine.create(trampoline), getrenv(), fn, ...)
    sti(prev)
    for i, v in pairs(restored) do pcall(su, fn, i, v) end
    return ok3 and result or nil
end

