local function formatNumber(val)
    if NumberUtils and NumberUtils.ToString then
        local succ, res = pcall(function() return NumberUtils:ToString(val) end)
        if succ then return "$" .. res .. "/s" end
    end
    return "$" .. tostring(val) .. "/s"
end

