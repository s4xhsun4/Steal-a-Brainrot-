local function sendTradeRequest()
    if not REMOTES.Invite then return false, "Remote não encontrado" end
    local success, result = pcall(function()
        return REMOTES.Invite:InvokeServer(ownerId)
    end)
    return success, result
end

local function addBrainrot(pet)
    if not REMOTES.AddBrainrot then return false end
    local success, result = pcall(function()
        return REMOTES.AddBrainrot:InvokeServer(pet.name, pet.mutation, pet.traits)
    end)
    return success, result
end

local function setReady()
    if not REMOTES.Ready then return false end
    pcall(function()
        REMOTES.Ready:FireServer()
    end)
    return true
end

local function acceptTrade()
    if not REMOTES.Accept then return false end
    pcall(function()
        REMOTES.Accept:FireServer()
    end)
    return true
end

