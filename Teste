-- ===== SYNCHRONIZER CACHE =====
local cachedChannelsTable = nil
local _gu = debug.getupvalues or getupvalues

local function initSynchronizerCache()
    if cachedChannelsTable then return cachedChannelsTable end
    
    local ok, sync = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Synchronizer"))
    end)
    
    if not (ok and type(sync) == "table") then return nil end
    
    if _gu and type(sync.GetAllChannels) == "function" then
        local ok2, ups = pcall(_gu, sync.GetAllChannels)
        if ok2 and type(ups) == "table" then
            for _, u in pairs(ups) do
                if type(u) == "table" then
                    local uuidCount = 0
                    for tk, tv in pairs(u) do
                        if type(tk) == "string" and tk:match("%-") and type(tv) == "table" then
                            uuidCount = uuidCount + 1
                            if uuidCount >= 2 then
                                cachedChannelsTable = u
                                return cachedChannelsTable
                            end
                        end
                    end
                end
            end
        end
    end
    
    if type(sync.GetAllChannels) == "function" then
        local ok3, res = pcall(sync.GetAllChannels)
        if ok3 and type(res) == "table" then
            cachedChannelsTable = res
            return cachedChannelsTable
        end
    end
    
    return nil
end

-- ===== DADOS =====
local AnimalsData, MutationsData, TraitsData

local function loadData()
    if AnimalsData then return true end
    pcall(function()
        local d = ReplicatedStorage:WaitForChild("Datas")
        AnimalsData = require(d:WaitForChild("Animals"))
        MutationsData = require(d:WaitForChild("Mutations"))
        TraitsData = require(d:WaitForChild("Traits"))
    end)
    return AnimalsData ~= nil
end

local function calculateGeneration(index, mutation, traits)
    if not loadData() then return 0 end
    local info = AnimalsData[index]
    if not info or not info.Generation then return 0 end
    local base = info.Generation
    local mult = 1
    
    if mutation and mutation ~= "None" and mutation ~= "" then
        local m = MutationsData[mutation]
        if m and m.Modifier then
            mult = mult + m.Modifier
        end
    end
    
    if type(traits) == "table" then
        for _, tr in ipairs(traits) do
            local t = TraitsData[tr]
            if t and t.MultiplierModifier then
                mult = mult + t.MultiplierModifier
            end
        end
    end
    
    return math.floor(base * mult)
end

local function formatNumber(val)
    local ok, NumberUtils = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Utils"):WaitForChild("NumberUtils"))
    end)
    if ok and NumberUtils and NumberUtils.ToString then
        return "$" .. NumberUtils:ToString(val) .. "/s"
    end
    return "$" .. tostring(val) .. "/s"
end

-- ===== ESCANEIA BRAINROTS DO JOGADOR =====
local function scanPlayerBrainrots()
    local t = initSynchronizerCache()
    if not t then return {} end
    
    local found = {}
    
    for plotName, channel in pairs(t) do
        if type(plotName) == "string" and plotName:match("%-") then
            local cacheTable = nil
            if type(channel) == "table" and channel.CacheTable then
                cacheTable = channel.CacheTable
            end
            
            if cacheTable then
                local owner = rawget(cacheTable, "Owner")
                local animalList = rawget(cacheTable, "AnimalList")
                
                if owner and type(owner) == "table" and owner.UserId == LocalPlayer.UserId then
                    if animalList and type(animalList) == "table" then
                        for slot, petData in pairs(animalList) do
                            if type(petData) == "table" then
                                local petIndex = petData.Index or "Unknown"
                                if TARGET_BRAINROTS[petIndex] then
                                    local mutation = petData.Mutation or "None"
                                    local traits = petData.Traits or {}
                                    local gen = calculateGeneration(petIndex, mutation, traits)
                                    
                                    table.insert(found, {
                                        name = petIndex,
                                        slotKey = slot,
                                        data = petData,
                                        gen = gen,
                                        mutation = mutation,
                                        traits = traits
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    table.sort(found, function(a, b) return a.gen > b.gen end)
    return found
end

