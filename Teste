local function getGeneration(entry)
    if type(entry) ~= "table" or not rawget(entry, "Index") then return 0 end
    local idx = rawget(entry, "Index")
    local data = AnimalsData and AnimalsData[idx]
    local base = data and rawget(data, "Generation") or 0
    local multiplier = 1
    local mutName = rawget(entry, "Mutation")
    if mutName and MutationsData then
        local mut = MutationsData[mutName]
        if mut then multiplier = multiplier + (rawget(mut, "Modifier") or 0) end
    end
    local traitsList = rawget(entry, "Traits")
    if type(traitsList) == "table" and TraitsData then
        for _, t in next, traitsList do
            local trait = TraitsData[t]
            if trait then multiplier = multiplier + (rawget(trait, "MultiplierModifier") or 0) end
        end
    end
    return base * multiplier
end

