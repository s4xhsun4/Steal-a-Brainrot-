local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local TARGET_NAME = "GeniusH10872"

print("[Test] Carregando Net...")
local Net = require(ReplicatedStorage.Packages.Net)

if not Net then
    warn("[Test] Net não encontrado!")
    return
end

print("[Test] Net carregado com sucesso!")

-- Lista de funções do Net para debug
print("[Test] Funções do Net:")
for k, v in pairs(Net) do
    if type(v) == "function" then
        print("  - " .. k)
    end
end

-- Tenta resolver os remotes
local remotes = {}
local remoteNames = {
    "TradeService/Invite",
    "TradeService/AcceptInvite",
    "TradeService/AddBrainrot",
    "TradeService/RemoveBrainrot",
    "TradeService/AddItem",
    "TradeService/RemoveItem",
    "TradeService/Ready",
    "TradeService/Accept",
    "TradeService/CancelTrade",
    "TradeService/DeclineInvite",
    "TradeService/SendChatMessage",
}

print("[Test] Resolvendo remotes...")
for _, name in ipairs(remoteNames) do
    local success, remote = pcall(function()
        return Net:RemoteFunction(name)
    end)
    if success and remote then
        print("[Test] ✅ " .. name .. " -> " .. tostring(remote))
        remotes[name] = remote
    else
        -- Tenta como RemoteEvent
        local success2, remote2 = pcall(function()
            return Net:RemoteEvent(name)
        end)
        if success2 and remote2 then
            print("[Test] ✅ " .. name .. " (Event) -> " .. tostring(remote2))
            remotes[name] = remote2
        else
            print("[Test] ❌ " .. name .. " -> não encontrado")
        end
    end
end

-- Pega o ID do alvo
local function getUserIdByName(name)
    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(name)
    end)
    if success and result then
        return result
    end
    return nil
end

local targetUserId = getUserIdByName(TARGET_NAME)
if not targetUserId then
    warn("[Test] Usuário não encontrado: " .. TARGET_NAME)
    return
end

print("[Test] Target UserId: " .. targetUserId)

-- Tenta enviar um pedido de trade
local inviteRemote = remotes["TradeService/Invite"]
if inviteRemote then
    print("[Test] Enviando pedido de trade para " .. TARGET_NAME .. " (" .. targetUserId .. ")...")
    local success, result = pcall(function()
        return inviteRemote:InvokeServer(targetUserId)
    end)
    if success then
        print("[Test] ✅ Pedido enviado com sucesso! Resultado: " .. tostring(result))
    else
        print("[Test] ❌ Falha ao enviar pedido: " .. tostring(result))
    end
else
    print("[Test] ❌ Remote de invite não encontrado!")
end

print("[Test] Script finalizado.")
