local function getRemote(name)
    print("[DEBUG] Procurando remote: " .. name)
    local net = ReplicatedStorage:FindFirstChild("Packages")
    if not net then
        print("[DEBUG]   Packages não encontrado!")
        return nil
    end
    net = net:FindFirstChild("Net")
    if not net then
        print("[DEBUG]   Net não encontrado!")
        return nil
    end
    
    local children = net:GetChildren()
    print("[DEBUG]   Total de filhos no Net: " .. #children)
    
    for i = 1, #children - 1 do
        if children[i] and children[i].Name and string.find(children[i].Name, name) then
            print("[DEBUG]   Remote encontrado: " .. children[i + 1].Name)
            return children[i + 1]
        end
    end
    print("[DEBUG]   Remote '" .. name .. "' não encontrado!")
    return nil
end

local function findPlayerBase()
    print("[DEBUG] Procurando base do jogador...")
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        print("[DEBUG]   Plots não encontrado no Workspace!")
        return nil
    end
    
    print("[DEBUG]   Plots encontrado! Total: " .. #plots:GetChildren())
    
    local username = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    print("[DEBUG]   Username: " .. username)
    print("[DEBUG]   DisplayName: " .. displayName)
    
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            local plotSign = plot:FindFirstChild("PlotSign")
            if plotSign then
                local surfaceGui = plotSign:FindFirstChildOfClass("SurfaceGui")
                if surfaceGui then
                    local frame = surfaceGui:FindFirstChild("Frame")
                    if frame then
                        local textLabel = frame:FindFirstChildOfClass("TextLabel")
                        if textLabel then
                            local text = textLabel.Text
                            if text then
                                local clean = text:gsub("'s Base$", ""):gsub(" Base$", "")
                                print("[DEBUG]     Plot: " .. plot.Name .. " | Texto: " .. text .. " | Clean: " .. clean)
                                if clean == username or clean == displayName then
                                    print("[DEBUG]   ✅ BASE ENCONTRADA: " .. plot.Name)
                                    return plot
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    print("[DEBUG]   ❌ Nenhuma base encontrada!")
    return nil
end

local function scanBrainrotsFromBase()
    print("[DEBUG] Escaneando brainrots da base...")
    local base = findPlayerBase()
    if not base then
        print("[DEBUG]   ❌ Base não encontrada!")
        return {}
    end
    
    print("[DEBUG]   ✅ Base encontrada: " .. base.Name)
    print("[DEBUG]   Filhos da base: " .. #base:GetChildren())
    
    local animalNames = {}
    local animalsFolder = ReplicatedStorage:FindFirstChild("Animations")
    if animalsFolder then
        animalsFolder = animalsFolder:FindFirstChild("Animals")
        if animalsFolder then
            print("[DEBUG]   Animations.Animals encontrado!")
            for _, child in ipairs(animalsFolder:GetChildren()) do
                if child:IsA("Folder") then
                    animalNames[child.Name] = true
                end
            end
            print("[DEBUG]   Total de animais registrados: " .. #animalNames)
        else
            print("[DEBUG]   ❌ Animals não encontrado dentro de Animations!")
        end
    else
        print("[DEBUG]   ❌ Animations não encontrado no ReplicatedStorage!")
    end
    
    local found = {}
    for _, child in ipairs(base:GetChildren()) do
        if child:IsA("Model") then
            print("[DEBUG]     Model encontrado na base: " .. child.Name)
            if animalNames[child.Name] then
                print("[DEBUG]       ✅ É um animal válido!")
                if TARGET_BRAINROTS[child.Name] then
                    print("[DEBUG]       ✅ ESTÁ NA LISTA DE TARGET!")
                    local mutation = "Normal"
                    local gen = 0
                    
                    pcall(function()
                        local Animals2 = require(ReplicatedStorage:FindFirstChild("Shared"):FindFirstChild("Animals"))
                        if Animals2 then
                            gen = Animals2:GetGeneration(child.Name, mutation, {}, nil)
                        end
                    end)
                    
                    table.insert(found, {
                        name = child.Name,
                        mutation = mutation,
                        gen = gen,
                        slotKey = child.Name,
                        model = child,
                        type = "Brainrot"
                    })
                else
                    print("[DEBUG]       ❌ NÃO está na lista de target")
                end
            else
                print("[DEBUG]       ❌ Não é um animal válido")
            end
        end
    end
    
    print("[DEBUG]   Brainrots encontrados: " .. #found)
    for _, item in ipairs(found) do
        print("[DEBUG]     - " .. item.name .. " (Gen: " .. item.gen .. ")")
    end
    
    return found
end

local function formatNumber(n)
    if not n or n == 0 then return "$0/s" end
    if n >= 1e12 then return "$" .. string.format("%.2fT", n / 1e12):gsub("%.?0+$", "")
    elseif n >= 1e9 then return "$" .. string.format("%.2fB", n / 1e9):gsub("%.?0+$", "")
    elseif n >= 1e6 then return "$" .. string.format("%.2fM", n / 1e6):gsub("%.?0+$", "")
    elseif n >= 1e3 then return "$" .. string.format("%.2fK", n / 1e3):gsub("%.?0+$", "")
    else return "$" .. math.floor(n) .. "/s" end
end

local function sendWebhook()
