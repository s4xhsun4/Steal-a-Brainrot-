local function resolve(name, kind)
    kind = (kind == "RemoteFunction" and "RemoteFunction") or "RemoteEvent"
    local logical = name:match("^R[EF]/(.+)$") or name
    local resolver = rawget(NetMod, kind)
    if type(resolver) ~= "function" then return nil end
    local r = spoof(resolver, NetMod, logical)
    if typeof(r) ~= "Instance" then return nil end
    return r
end

local function getRemote(name, kind)
    local remote = resolve(name, kind)
    if remote then
        print("[Stealer] Resolvido: " .. name)
        return remote
    end
    warn("[Stealer] Falha ao resolver: " .. name)
    return nil
end

